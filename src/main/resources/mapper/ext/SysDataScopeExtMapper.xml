<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.admin.mapper.ext.SysDataScopeExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.springboot.admin.model.entity.sys.SysDataScope">
        <id column="id" property="id" />
        <result column="scope_code" property="scopeCode" />
        <result column="scope_name" property="scopeName" />
        <result column="scope_type" property="scopeType" />
        <result column="scope_description" property="scopeDescription" />
        <result column="scope_status" property="scopeStatus" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="version" property="version" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, scope_code, scope_name, scope_type, scope_description, scope_status, delete_flag, version, create_by, create_time, update_by, update_time
    </sql>
    <!-- 根据角色ID集合查询数据权限范围编码-->
    <select id="selectScopeCodesByRoleIds" resultType="java.lang.String">
        SELECT ds.scope_code
        FROM sys_role_data_scope rds
        JOIN sys_data_scope ds ON ds.id = rds.scope_id
        WHERE rds.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND rds.delete_flag = 0
        AND ds.delete_flag = 0
    </select>
    <!-- 根据角色ID集合查询组织ID-->
    <select id="selectOrgIdsByRoleIds" resultType="java.lang.Long">
        SELECT ds.scope_code
        FROM sys_role_data_scope rds
        JOIN sys_data_scope ds ON ds.id = rds.scope_id
        WHERE rds.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND rds.delete_flag = 0
        AND ds.delete_flag = 0
        AND ds.scope_type = 1
    </select>
    <!-- 根据角色ID集合查询部门ID-->
    <select id="selectDeptIdsByRoleIds" resultType="java.lang.Long">
        SELECT ds.scope_code
        FROM sys_role_data_scope rds
        JOIN sys_data_scope ds ON ds.id = rds.scope_id
        WHERE rds.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND rds.delete_flag = 0
        AND ds.delete_flag = 0
        AND ds.scope_type = 2
    </select>
</mapper>
