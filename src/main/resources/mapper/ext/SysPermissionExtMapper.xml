<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.admin.mapper.ext.SysPermissionExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.springboot.admin.model.entity.sys.SysPermission">
        <id column="id" property="id" />
        <result column="permission_code" property="permissionCode" />
        <result column="permission_name" property="permissionName" />
        <result column="permission_type" property="permissionType" />
        <result column="permission_status" property="permissionStatus" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="version" property="version" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, permission_code, permission_name, permission_type, permission_status, delete_flag, version, create_by, create_time, update_by, update_time
    </sql>
    <!-- 根据用户ID查询权限点 -->
    <select id="selectPermissionsByUserId" resultType="com.springboot.admin.model.entity.sys.SysPermission">
        SELECT DISTINCT p.*
        FROM sys_permission p
        INNER JOIN sys_role_permission rp
        ON rp.permission_id = p.id
        AND rp.delete_flag = 0
        INNER JOIN sys_user_role ur
        ON ur.role_id = rp.role_id
        AND ur.delete_flag = 0
        WHERE ur.user_id = #{userId}
        AND p.permission_status = 1
        AND p.delete_flag = 0
    </select>

    <!-- 根据角色ID集合查询权限点code列表 -->
    <select id="selectPermissionCodesByRoleIds" resultType="java.lang.String">
        SELECT DISTINCT p.permission_code
        FROM sys_permission p
        INNER JOIN sys_role_permission rp
        ON rp.permission_id = p.id AND rp.delete_flag = 0
        WHERE rp.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND p.permission_status = 1
        AND p.delete_flag = 0
    </select>
</mapper>
