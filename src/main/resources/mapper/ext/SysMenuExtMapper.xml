<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.admin.mapper.ext.SysMenuExtMapper">
    <!-- ======================== -->
    <!-- 1️⃣ 通用查询映射结果 -->
    <!-- ======================== -->
    <resultMap id="BaseResultMap" type="com.springboot.admin.model.entity.sys.SysMenu">
        <id column="id" property="id" />
        <result column="menu_parent_id" property="menuParentId" />
        <result column="menu_name" property="menuName" />
        <result column="menu_path" property="menuPath" />
        <result column="menu_component" property="menuComponent" />
        <result column="menu_icon" property="menuIcon" />
        <result column="menu_type" property="menuType" />
        <result column="menu_sort" property="menuSort" />
        <result column="menu_visible" property="menuVisible" />
        <result column="menu_status" property="menuStatus" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="version" property="version" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>
    <!-- ======================== -->
    <!-- 2️⃣ 通用查询结果列 -->
    <!-- ======================== -->
    <sql id="Base_Column_List">
        id, menu_parent_id, menu_name, menu_path, menu_component, menu_icon, menu_type, menu_sort, menu_visible, menu_status, delete_flag, version, create_by, create_time, update_by, update_time
    </sql>


    <!-- ======================== -->
    <!-- 3️⃣ 根据用户ID查询菜单 -->
    <!-- ======================== -->
    <select id="selectMenusByUserId" resultType="com.springboot.admin.model.entity.sys.SysMenu">
        SELECT DISTINCT m.*
        FROM sys_menu m
        INNER JOIN sys_menu_permission mp ON m.id = mp.menu_id AND mp.delete_flag = 0
        INNER JOIN sys_permission p ON mp.permission_id = p.id AND p.delete_flag = 0
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        INNER JOIN sys_user_role ur ON rp.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
        ORDER BY m.menu_parent_id, m.menu_sort
    </select>
    <!-- ======================== -->
    <!-- 4️⃣ 根据角色ID集合查询菜单 -->
    <!-- ======================== -->
    <select id="selectMenusByRoleIds" parameterType="java.util.List" resultType="com.springboot.admin.model.entity.sys.SysMenu">
        SELECT DISTINCT m.*
        FROM sys_menu m
        INNER JOIN sys_role_menu rm
        ON m.id = rm.menu_id
        AND rm.delete_flag = 0
        WHERE rm.role_id IN
        <foreach collection="roleIds"
                 item="roleId"
                 open="("
                 separator=","
                 close=")">
            #{roleId}
        </foreach>
        AND m.menu_status = 1
        AND m.menu_visible = 1
        AND m.delete_flag = 0
        AND m.menu_type IN (0,1,2)
        ORDER BY m.menu_parent_id, m.menu_sort
    </select>
    <!-- ======================== -->
    <!-- 5️⃣ 查询菜单及其所有子菜单ID（递归） -->
    <!-- ======================== -->
    <!--
        用途：
        - 删除菜单时（逻辑 / 物理）
        - 确保父菜单删除时，子菜单不会残留

        说明：
        - 使用 MySQL 8+ WITH RECURSIVE
        - 自动过滤 delete_flag = 0
    -->
    <select id="selectMenuAndChildrenIds"
            resultType="java.lang.Long">
        WITH RECURSIVE menu_tree AS (
        -- ① 起始节点（当前菜单）
        SELECT id, menu_parent_id
        FROM sys_menu
        WHERE id = #{menuId}
        AND delete_flag = 0

        UNION ALL

        -- ② 递归查找子菜单
        SELECT m.id, m.menu_parent_id
        FROM sys_menu m
        INNER JOIN menu_tree mt
        ON m.menu_parent_id = mt.id
        WHERE m.delete_flag = 0
        )
        SELECT id FROM menu_tree
    </select>
</mapper>
